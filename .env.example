# 应用配置
APP_HOST=127.0.0.1
APP_PORT=8000
APP_DEBUG=true
LOG_LEVEL=INFO

# CORS（允许的源列表，JSON 格式）
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# 数据库（生产环境示例：postgresql+asyncpg://user:password@localhost:5432/dbname）
DATABASE_URL=sqlite+aiosqlite:///./dev.db

# JWT — 生产环境必须修改 JWT_SECRET（设置 APP_DEBUG=false 时会强制检查）
JWT_SECRET=change-this-in-production-at-least-32-bytes
JWT_EXPIRATION_DAYS=90
JWT_ALGORITHM=HS256
